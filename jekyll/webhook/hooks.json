[
  {
    "id": "on-github-push",
    "execute-command": "/opt/jekyll/update-content.sh",
    "response-message": "Update scheduled.",
    "trigger-rule-mismatch-http-response-code": 403,
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "{{ getenv "GITHUB_SECRET" | js }}",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "push",
            "parameter": {
              "source": "header",
              "name": "X-GitHub-Event"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/{{ getenv "GITHUB_BRANCH" | js }}",
            "parameter": {
              "source": "payload",
              "name": "ref"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "{{ getenv "GITHUB_REPOSITORY" | js }}",
            "parameter": {
              "source": "payload",
              "name": "repository.full_name"
            }
          }
        }
      ]
    }
  }
]
